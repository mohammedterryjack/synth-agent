# Copy to .env (loaded by systemd/synth-agent.service). Keys stay in SYNTH_ENV_FILE (DELL_LLM_API_KEY).
# this machine's LAN address for the viewer
SYNTH_BIND=192.0.2.10
# GPU box media gateway (music, images, video)
DELL_MEDIA=http://192.0.2.20:8091
# GPU box TTS service
DELL_SYNTH=http://192.0.2.20:8094
# OpenAI-compatible chat/vision endpoint for critique and storyboard
DELL_LLM=http://192.0.2.20:8090/v1
