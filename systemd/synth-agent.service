[Unit]
Description=Synth agent service (bridge to Dell music :8091 and dell-synth :8094, job socket, LAN viewer on the LAN address :8648)
After=network-online.target

[Service]
EnvironmentFile=%h/Code/synth-agent/.env
Type=simple
WorkingDirectory=%h/Code/synth-agent
ExecStart=/usr/bin/node %h/Code/synth-agent/service.js
Restart=on-failure
RestartSec=5
MemoryMax=600M
MemorySwapMax=0
CPUQuota=200%
CPUWeight=20
Nice=10
Environment=NODE_ENV=production

[Install]
WantedBy=default.target
